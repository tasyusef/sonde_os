# Copy to .env.local. Everything here is optional: with no file, pages
# read public XRPL nodes straight from the browser and there is no live
# feed on /network or the account page. Values are baked in at build time.

# Live feed relay (relay/). Start it with `pnpm relay:dev`. The socket
# lives at /live; the bare origin returns 404.
VITE_LIVE_RELAY_URL=ws://127.0.0.1:8788/live

# Cloudflare Web Analytics site token (dashboard > Web Analytics > Manage
# site). Production builds only. Set it in Cloudflare's build settings, not
# here, so local production builds don't count as visits.
# VITE_CF_BEACON_TOKEN=

# Origin used for canonical URLs, the sitemap and robots.txt.
# Defaults to https://sondelab.com.
# VITE_SITE_URL=http://localhost:3000
