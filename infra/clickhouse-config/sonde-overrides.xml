<?xml version="1.0"?>
<!--
  Sonde overrides for ClickHouse default config.

  Mounted into the container at /etc/clickhouse-server/config.d/sonde-overrides.xml
  via a bind in /opt/sonde/docker-compose.yml. Bind-mount syntax:

    volumes:
      - ch_data:/var/lib/clickhouse
      - /opt/sonde/ch-config/sonde-overrides.xml:/etc/clickhouse-server/config.d/sonde-overrides.xml:ro

  Config.d files are merged into the running config on container start.
  Confirm via:
    docker exec sonde-clickhouse-1 grep -A 12 '<text_log>' \
      /var/lib/clickhouse/preprocessed_configs/config.xml

  ─────────────────────────────────────────────────────────────────────

  text_log: dropped from 'trace' to 'warning' on 2026-05-02. The
  trace-level firehose was writing ~50 GB/day of internal log entries
  to system.text_log, defeating any TTL we set (cleanup script would
  truncate 41 GB and the table was back to 8 MB ten seconds later).
  'warning' keeps the table available for actual problems without the
  noise — observed growth dropped to effectively zero per minute.

  See scripts/cleanup-ch-system-logs.ts for the truncate + TTL story.
-->
<clickhouse>
  <text_log>
    <level>warning</level>
  </text_log>
</clickhouse>
