[Unit]
Description=ClickHouse system-log table cleanup (oneshot)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sonde_intel
EnvironmentFile=/opt/sonde_intel/.env
Environment="NODE_OPTIONS=--conditions react-server"
ExecStart=/usr/bin/pnpm exec tsx scripts/cleanup-ch-system-logs.ts --apply
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sonde-ch-cleanup
