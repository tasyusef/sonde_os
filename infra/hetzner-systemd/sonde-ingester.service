[Unit]
Description=Sonde Unified Ingester (live)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sonde_intel
EnvironmentFile=/opt/sonde_intel/.env
Environment="NODE_OPTIONS=--conditions react-server"
ExecStart=/usr/bin/pnpm tsx scripts/run-ingester.ts
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sonde-ingester

[Install]
WantedBy=multi-user.target
