[Unit]
Description=Sonde nightly PG backup to R2 (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sonde_intel
EnvironmentFile=/opt/sonde_intel/.env
ExecStart=/opt/sonde_intel/infra/hetzner-systemd/pg-backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sonde-pg-backup
