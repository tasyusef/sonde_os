[Unit]
Description=Sonde smart money scorer cron (oneshot)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sonde_intel
EnvironmentFile=/opt/sonde_intel/.env
Environment="NODE_OPTIONS=--conditions react-server"
ExecStart=/usr/bin/pnpm tsx scripts/run-smart-money-scorer.ts
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sonde-smart-money-scorer
