{
  "name": "sonde",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "pnpm migrate && next start",
    "migrate": "tsx scripts/migrate.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
