    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
