{
  "name": "sonde",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.30.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "wrangler dev --port 3000",
    "lint": "eslint --max-warnings 0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm relay:check",
    "relay:check": "sh relay/check.sh",
    "relay:dev": "cd relay && wrangler dev -c wrangler.toml --port 8788",
    "relay:deploy": "cd relay && wrangler deploy -c wrangler.toml",
    "audit:code": "tsx scripts/audit.ts",
    "brand": "tsx scripts/brand.ts",
    "tokens": "tsx scripts/tokens.ts",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "motion": "^14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "ripple-address-codec": "^5.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.151.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "esbuild",
      "sharp",
      "simple-git-hooks",
      "utf-8-validate"
    ]
  }
}
