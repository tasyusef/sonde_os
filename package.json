    "stripe": "^22.0.2",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.0",
    "xrpl": "^4.6.0",
    "xumm-sdk": "^1.11.2",
    "zod": "^3.25.76"
